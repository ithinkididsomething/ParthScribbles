rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidReview(data) {
      return data.keys().hasAll(['id', 'gameId', 'userName', 'rating', 'comment', 'createdAt']) &&
             data.keys().hasOnly(['id', 'gameId', 'userName', 'userAvatar', 'rating', 'comment', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.gameId is string && data.gameId.size() <= 128 &&
             data.userName is string && data.userName.size() <= 64 &&
             (data.rating is int || data.rating is float) && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() <= 1000 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('userAvatar' in data.keys()) || (data.userAvatar is string && data.userAvatar.size() <= 512));
    }

    function isValidGameSubmission(data) {
      return data.keys().hasAll(['id', 'title', 'genre', 'externalUrl', 'description', 'developerName', 'status', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 128 &&
             data.genre is string && data.genre.size() <= 64 &&
             data.externalUrl is string && data.externalUrl.size() <= 512 &&
             data.description is string && data.description.size() <= 1000 &&
             data.developerName is string && data.developerName.size() <= 64 &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.createdAt is string;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /test/{testId} {
      allow read: if true;
      allow write: if false;
    }

    match /games/{gameId} {
      allow read: if true;
      allow create: if isValidId(gameId) && isValidGameSubmission(request.resource.data);
      allow update, delete: if isValidId(gameId);
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidId(reviewId) && isValidReview(request.resource.data);
      allow update, delete: if false;
    }
  }
}
