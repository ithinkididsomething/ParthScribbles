{
  "entities": {
    "Review": {
      "title": "Review",
      "description": "User review for an arcade game",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "gameId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 64 },
        "userAvatar": { "type": "string", "maxLength": 512 },
        "rating": { "type": "integer" },
        "comment": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "gameId", "userName", "rating", "comment", "createdAt"]
    },
    "Game": {
      "title": "Game",
      "description": "Indie arcade game catalog entry with community developer submission lifecycle",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 500 },
        "longDescription": { "type": "string", "maxLength": 2000 },
        "genre": { "type": "string", "maxLength": 64 },
        "coverUrl": { "type": "string", "maxLength": 512 },
        "externalUrl": { "type": "string", "maxLength": 512 },
        "controls": { "type": "string", "maxLength": 500 },
        "developerName": { "type": "string", "maxLength": 64 },
        "developerType": { "type": "string", "enum": ["verified", "community"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "playCount": { "type": "integer" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "genre", "externalUrl", "developerName", "status"]
    }
  },
  "firestore": {
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Public game reviews collection"
    },
    "/games/{gameId}": {
      "schema": { "$ref": "#/entities/Game" },
      "description": "Arcade games metadata and community submissions collection"
    }
  }
}
